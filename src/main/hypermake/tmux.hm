class session:

    def submit(script_file, wd) -> pid:
        tmux new-session -d -s $HYPERMAKE_JOB_ID
        tmux set-option -t $HYPERMAKE_JOB_ID remain-on-exit on
        tmux respawn-window -t $HYPERMAKE_JOB_ID -k "bash -c 'cd $wd && source $script_file > stdout 2> stderr'"
        echo $HYPERMAKE_JOB_ID > pid

    def poll(pid):
        is_dead=$(tmux list-panes -t $pid -F '#{pane_dead}')
        if [ "$is_dead" = "1" ]; then
            exit_code=$(tmux list-panes -t $pid -F '#{pane_dead_status}')
            echo $exit_code
        else
            echo ""
        fi

    def kill(pid):
        tmux kill-session -t $pid
