## Symbolically links the given path as a package.
def symlink(path) -> out:
  ln -s $path $out

## Execute the script with the given interpreter.
class run(interpreter):
  def run(_internal_interpreter_script):
    $interpreter $_internal_interpreter_script


## Executes the script in background using nohup, allowing the process to persist
## even if the parent shell exits. Useful for long-running jobs.
object nohup:
  def submit(_internal_script) -> pid:
    nohup sh -c ". $_internal_script; echo \$? > \$\$.exitcode" > stdout 2> stderr & echo $! > pid

  def poll(pid):
    if kill -0 $pid 2>/dev/null
    then
      # process still running, return empty string
      echo ""
    else
      # process finished, return exit code
      if [ -f $pid.exitcode ]
      then
        cat $pid.exitcode
      else
        echo 1
      fi
    fi

  def cancel(pid):
    kill -TERM $pid 2>/dev/null || true
